# Never commit real credentials. Configure these in Railway Variables or .env.local.
APP_URL=http://localhost:3000
SOCIALAPI_KEY=
# Operator email plus one-time setup token. After signing up, claim admin in Settings.
ADMIN_EMAIL=you@example.com
ADMIN_SETUP_TOKEN=
# Optional: automatic registration from Settings stores the secret in the server DB.
SOCIALAPI_WEBHOOK_SECRET=
# Railway: mount a persistent volume at /data and use /data/rainy.db.
DATABASE_PATH=./data/rainy.db
NEXT_TELEMETRY_DISABLED=1

# Required to encrypt each workspace's QPay credentials. Generate once and preserve it.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
